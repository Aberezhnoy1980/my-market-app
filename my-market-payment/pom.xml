<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ru.yandex.practicum</groupId>
		<artifactId>my-market</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>my-market-payment</artifactId>
	<name>my-market-payment</name>
	<description>RESTful-сервис платежей (WebFlux, OpenAPI)</description>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>${openapi-generator.version}</version>
				<executions>
					<execution>
						<id>payment-api-server</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.parent.basedir}/api/payment-api.yaml</inputSpec>
							<generatorName>spring</generatorName>
							<apiPackage>ru.yandex.practicum.mymarket.payment.generated.api</apiPackage>
							<modelPackage>ru.yandex.practicum.mymarket.payment.generated.model</modelPackage>
							<invokerPackage>ru.yandex.practicum.mymarket.payment.generated</invokerPackage>
							<generateApiTests>false</generateApiTests>
							<generateModelTests>false</generateModelTests>
							<configOptions>
								<library>spring-boot</library>
								<reactive>true</reactive>
								<useSpringBoot3>true</useSpringBoot3>
								<delegatePattern>true</delegatePattern>
								<interfaceOnly>false</interfaceOnly>
								<openApiNullable>false</openApiNullable>
								<useTags>true</useTags>
								<dateLibrary>java8</dateLibrary>
								<documentationProvider>none</documentationProvider>
								<useResponseEntity>false</useResponseEntity>
							</configOptions>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Генератор добавляет свой SpringBootApplication — оставляем единственный main-класс вручную. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<executions>
					<execution>
						<id>drop-generated-spring-boot-entrypoint</id>
						<phase>process-sources</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<delete quiet="true" file="${project.build.directory}/generated-sources/openapi/src/main/java/ru/yandex/practicum/mymarket/payment/generated/OpenApiGeneratorApplication.java" />
								<delete quiet="true" file="${project.build.directory}/generated-sources/openapi/src/test/java/ru/yandex/practicum/mymarket/payment/generated/OpenApiGeneratorApplicationTests.java" />
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>ru.yandex.practicum.mymarket.payment.MyMarketPaymentApplication</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
